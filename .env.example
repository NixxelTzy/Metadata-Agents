# =============================
# Groq — Fitur Riset (WAJIB untuk AI research)
# =============================
# Set di Vercel: Settings \u2192 Environment Variables
# Nama env: GROQ_API_KEY_RISET
# Dipakai oleh: RESEARCH_ENGINE.ts, RESEARCH_ENGINE_DEEP.ts, lib/groq-riset.ts
#
# Dapatkan API key di: https://console.groq.com/keys

GROQ_API_KEY_RISET=""

# =============================
# Model AI — WAJIB diisi
# =============================
# Model Groq yang dipakai di SEMUA fitur (chat, metadata, riset, firewall)
# Diset di .env.local untuk development, dan di Vercel Environment Variables untuk production
# Jangan ganti kecuali ada model baru yang lebih baik

MODEL_AI="llama-3.3-70b-versatile"

# =============================
# Groq \u2014 Fitur Umum (metadata, chat)
# =============================
# Opsional jika sudah ada GROQ_API_KEY_RISET.
# Gunakan rotasi multi-key untuk volume tinggi.

GROQ_API_KEY_1=""
GROQ_API_KEY_2=""
GROQ_API_KEY_3=""
GROQ_API_KEY_4=""
GROQ_API_KEY_5=""
GROQ_API_KEY_6=""
GROQ_API_KEY_7=""
GROQ_API_KEY_8=""
GROQ_API_KEY_9=""
GROQ_API_KEY_10=""

# =============================
# (Optional) Upstash Redis
# =============================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =============================
# (Optional) Vercel Monitor
# =============================
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# =============================
# Auth / JWT
# =============================
JWT_SECRET=""

# =============================
# Gmail OTP
# =============================
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

